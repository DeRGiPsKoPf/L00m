--- /dev/null
+++ b/boards/fysetc_r4_map.h
@@ -0,0 +1,149 @@
+/*
+  fysetc_r4_map.h - driver code for RP2040 ARM processors
+
+  Board map for the FYSETC R4 V1.0 (RP2040, 4x onboard TMC2209 in UART mode).
+  Pins taken from the FYSETC R4 V1.0 schematic and pinout:
+  https://github.com/FYSETC/FYSETC-R4
+
+  Part of grblHAL
+
+  grblHAL is free software: you can redistribute it and/or modify
+  it under the terms of the GNU General Public License as published by
+  the Free Software Foundation, either version 3 of the License, or
+  (at your option) any later version.
+
+  grblHAL is distributed in the hope that it will be useful,
+  but WITHOUT ANY WARRANTY; without even the implied warranty of
+  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+  GNU General Public License for more details.
+
+  You should have received a copy of the GNU General Public License
+  along with grblHAL. If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#if N_ABC_MOTORS > 1
+#error "Axis configuration is not supported!"
+#endif
+
+#if WIFI_ENABLE || BLUETOOTH_ENABLE == 1
+#error "Wireless networking is not supported!"
+#endif
+
+#define BOARD_NAME "FYSETC R4 V1.0"
+#define BOARD_URL "https://github.com/FYSETC/FYSETC-R4"
+
+// TMC2209 single wire UART: PDN_TX = GPIO8, PDN_RX = GPIO9 (hardware UART1 defaults)
+#define SERIAL1_PORT 1
+#undef TRINAMIC_ENABLE
+#undef TRINAMIC_UART_ENABLE
+#define TRINAMIC_ENABLE 2209
+#define TRINAMIC_UART_ENABLE 1
+#define TRINAMIC_STREAM 1
+#undef TRINAMIC_MIXED_DRIVERS
+#define TRINAMIC_MIXED_DRIVERS 0
+// The R4 uses 0.22 Ohm sense resistors (R74 etc. in the schematic), grblHAL default is 110 mOhm.
+#undef TRINAMIC_R_SENSE
+#define TRINAMIC_R_SENSE 220 // mOhm
+
+#define HAS_BOARD_INIT
+
+// Define step pulse output pins.
+#define STEP_PORT                   GPIO_PIO_1 // Single pin PIO SM
+#define X_STEP_PIN                  3
+#define Y_STEP_PIN                  16
+#define Z_STEP_PIN                  19
+
+// Define step direction output pins.
+#define DIRECTION_PORT              GPIO_OUTPUT
+#define DIRECTION_OUTMODE           GPIO_MAP
+#define X_DIRECTION_PIN             2
+#define Y_DIRECTION_PIN             15
+#define Z_DIRECTION_PIN             18
+
+// Define stepper driver enable/disable output pins.
+#define ENABLE_PORT                 GPIO_OUTPUT
+#define X_ENABLE_PIN                4
+#define Y_ENABLE_PIN                14
+#define Z_ENABLE_PIN                17
+
+// Fourth driver (labelled E): ganged/auto-squared axis motor or A axis.
+#if N_ABC_MOTORS > 0
+#define M3_AVAILABLE
+#define M3_STEP_PIN                 6
+#define M3_DIRECTION_PIN            5
+#define M3_ENABLE_PIN               7
+#define M3_LIMIT_PIN                10 // E-STOP connector
+#endif
+
+// Define homing/hard limit switch input pins.
+#define X_LIMIT_PIN                 11 // X-STOP
+#define Y_LIMIT_PIN                 12 // Y-STOP
+#define Z_LIMIT_PIN                 13 // Z-STOP
+
+// Auxiliary outputs (MOSFET outputs, all usable with M62-M65)
+#define AUXOUTPUT0_PORT             GPIO_OUTPUT // Spindle PWM
+#define AUXOUTPUT0_PIN              20 // FAN0
+#define AUXOUTPUT1_PORT             GPIO_OUTPUT // Spindle direction
+#define AUXOUTPUT1_PIN              21 // FAN1
+#define AUXOUTPUT2_PORT             GPIO_OUTPUT // Spindle enable
+#define AUXOUTPUT2_PIN              24 // HEAD (heater MOSFET)
+#define AUXOUTPUT3_PORT             GPIO_OUTPUT // Coolant flood
+#define AUXOUTPUT3_PIN              23 // BED (bed MOSFET)
+
+// RC servo (M280 P0 S<angle>): 3.3 V logic signal on the Laser connector.
+// NOTE: GPIO22 also drives the FAN2 MOSFET, do not connect a fan to FAN2.
+#define AUXOUTPUT0_PWM_PIN          22
+
+// Define driver spindle pins
+#if DRIVER_SPINDLE_ENABLE
+#define SPINDLE_PORT                GPIO_OUTPUT
+#endif
+#if DRIVER_SPINDLE_ENABLE & SPINDLE_ENA
+#define SPINDLE_ENABLE_PIN          AUXOUTPUT2_PIN
+#endif
+#if DRIVER_SPINDLE_ENABLE & SPINDLE_PWM
+#define SPINDLE_PWM_PIN             AUXOUTPUT0_PIN
+#endif
+#if DRIVER_SPINDLE_ENABLE & SPINDLE_DIR
+#define SPINDLE_DIRECTION_PIN       AUXOUTPUT1_PIN
+#endif
+
+// Define flood coolant enable output pin.
+#if COOLANT_ENABLE
+#define COOLANT_PORT                GPIO_OUTPUT
+#endif
+#if COOLANT_ENABLE & COOLANT_FLOOD
+#define COOLANT_FLOOD_PIN           AUXOUTPUT3_PIN
+#endif
+
+// Auxiliary inputs
+#define AUXINPUT0_PIN               25 // PROBE connector
+#ifndef M3_LIMIT_PIN
+#define AUXINPUT1_PIN               10 // E-STOP connector, free when not used as limit input
+#endif
+
+#if PROBE_ENABLE
+#define PROBE_PIN                   AUXINPUT0_PIN
+#endif
+
+// Define user-control controls (cycle start, reset, feed hold) input pins.
+#if (CONTROL_ENABLE & CONTROL_HALT) && defined(AUXINPUT1_PIN)
+#undef CONTROL_ENABLE
+#define CONTROL_ENABLE              CONTROL_HALT
+#define RESET_PIN                   AUXINPUT1_PIN
+#else
+#undef CONTROL_ENABLE
+#define CONTROL_ENABLE              0
+#endif
+
+// Thermistor inputs T0, T1, T2
+#define AUXINPUT0_ANALOG_PIN        26 // T0
+#define AUXINPUT1_ANALOG_PIN        27 // T1
+
+#if RGB_LED_ENABLE
+#define NEOPIXELS_PIN               29 // 5V-RGB connector
+#endif
+
+#if MODBUS_ENABLE
+#define MODBUS_RTU_STREAM           0
+#endif
